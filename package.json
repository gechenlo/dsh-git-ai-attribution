{
  "name": "dsh-git-ai-attribution",
  "version": "0.5.0",
  "description": "Attribute any AI-tool edits into TRAE's git-ai store so they count in the TRAE enterprise AI contribution report. Standalone CLI + local web dashboard; no DSH required.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "ai-attr": "./bin/ai-attr.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "web",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-attribution",
    "git-ai",
    "trae",
    "post-commit-hook",
    "dsh-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gechenlo/dsh-git-ai-attribution.git"
  },
  "bugs": {
    "url": "https://github.com/gechenlo/dsh-git-ai-attribution/issues"
  },
  "homepage": "https://github.com/gechenlo/dsh-git-ai-attribution#readme",
  "license": "MIT"
}
