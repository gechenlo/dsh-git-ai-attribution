{
  "name": "dsh-git-ai-attribution",
  "version": "0.4.4",
  "description": "Attribute DSH AI edits to TRAE's git-ai store so they appear in the TRAE enterprise AI contribution report.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "git-ai",
    "trae",
    "ai-attribution"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gechenlo/dsh-git-ai-attribution.git"
  },
  "bugs": {
    "url": "https://github.com/gechenlo/dsh-git-ai-attribution/issues"
  },
  "homepage": "https://github.com/gechenlo/dsh-git-ai-attribution#readme",
  "license": "MIT"
}
